    {
      "name": "job_title_analysis",
      "displayName": "Job Title Insights",
      "queryLines": [
        "SELECT\n",
        "  title,\n",
        "  COUNT(*) as job_count,\n",
        "  CASE\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%senior%'\n",
        "      OR LOWER(title) LIKE '%sr.%'\n",
        "      OR LOWER(title) LIKE '%lead%'\n",
        "      OR LOWER(title) LIKE '%principal%'\n",
        "    THEN\n",
        "      'Senior'\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%junior%'\n",
        "      OR LOWER(title) LIKE '%jr.%'\n",
        "      OR LOWER(title) LIKE '%entry%'\n",
        "    THEN\n",
        "      'Junior'\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%manager%'\n",
        "      OR LOWER(title) LIKE '%director%'\n",
        "      OR LOWER(title) LIKE '%head%'\n",
        "    THEN\n",
        "      'Management'\n",
        "    ELSE 'Mid-Level'\n",
        "  END as seniority_level,\n",
        "  CASE\n",
        "    WHEN LOWER(title) LIKE '%engineer%' THEN 'Engineer'\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%developer%'\n",
        "      OR LOWER(title) LIKE '%dev %'\n",
        "    THEN\n",
        "      'Developer'\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%data%'\n",
        "      AND LOWER(title) LIKE '%scientist%'\n",
        "    THEN\n",
        "      'Data Scientist'\n",
        "    WHEN LOWER(title) LIKE '%analyst%' THEN 'Analyst'\n",
        "    WHEN LOWER(title) LIKE '%designer%' THEN 'Designer'\n",
        "    WHEN LOWER(title) LIKE '%manager%' THEN 'Manager'\n",
        "    WHEN LOWER(title) LIKE '%architect%' THEN 'Architect'\n",
        "    ELSE 'Other'\n",
        "  END as role_category,\n",
        "  CASE\n",
        "    WHEN LOWER(title) LIKE '%software%' THEN 'Software'\n",
        "    WHEN LOWER(title) LIKE '%data%' THEN 'Data'\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%machine learning%'\n",
        "      OR LOWER(title) LIKE '%ml %'\n",
        "      OR LOWER(title) LIKE '%ai %'\n",
        "    THEN\n",
        "      'AI/ML'\n",
        "    WHEN\n",
        "      LOWER(title) LIKE '%devops%'\n",
        "      OR LOWER(title) LIKE '%sre%'\n",
        "    THEN\n",
        "      'DevOps/SRE'\n",
        "    WHEN LOWER(title) LIKE '%cloud%' THEN 'Cloud'\n",
        "    WHEN LOWER(title) LIKE '%security%' THEN 'Security'\n",
        "    WHEN LOWER(title) LIKE '%product%' THEN 'Product'\n",
        "    ELSE 'General'\n",
        "  END as domain\n",
        "FROM\n",
        "  job.target.dim_job\n",
        "GROUP BY\n",
        "  title\n",
        "ORDER BY\n",
        "  job_count DESC"
      ]
    }
  ],
